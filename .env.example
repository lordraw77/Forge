# Forge bootstrap configuration. This is the complete list of values read from .env;
# everything else is configured from the GUI. Generate a real file with `make env`.

# Initial administrator, created on first start only
FORGE_ADMIN_USERNAME=admin
FORGE_ADMIN_EMAIL=admin@example.com
FORGE_ADMIN_PASSWORD=change-me

# Boot values (cannot live in the database they point to)
FORGE_DATABASE_URL=postgresql+asyncpg://forge:secret@db:5432/forge
FORGE_MASTER_KEY=<32-byte base64 key, e.g. `openssl rand -base64 32`>
FORGE_PUBLIC_URL=https://forge.example.com

# Optional deployment wiring read by Compose (not application settings, ADR-007):
# corporate egress proxy for calls to model providers, S3 and model downloads, and an extra
# trusted root CA (PEM file in deploy/compose/extra-ca/) when the proxy inspects TLS.
#FORGE_HTTP_PROXY=http://proxy.corp.example:3128
#FORGE_HTTPS_PROXY=http://proxy.corp.example:3128
#FORGE_NO_PROXY=.corp.example
#FORGE_EXTRA_CA_FILE=/etc/forge/extra-ca/corp-root.pem
# Reverse proxies / load balancers in front of Forge (comma-separated CIDRs); see README.
#FORGE_TRUSTED_PROXIES=10.0.0.0/8

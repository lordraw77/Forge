# Served by nginx-unprivileged on :8080. TLS terminates at the edge proxy (threat model §4).
# Behind a reverse proxy or load balancer, name it in FORGE_TRUSTED_PROXIES (comma-separated
# CIDRs or addresses, e.g. "10.0.0.0/8,192.168.1.10"): only from those does nginx believe
# X-Forwarded-For / X-Forwarded-Proto. By default none is trusted, so a client cannot choose
# the address used for login rate limiting and the audit log.
# Generated from FORGE_TRUSTED_PROXIES by docker-entrypoint.d/40-forge-proxies.sh.
geo $realip_remote_addr $from_trusted_proxy {
    default 0;
${FORGE_GEO_ENTRIES}
}
map "$from_trusted_proxy:$http_x_forwarded_proto" $forwarded_proto {
    default $scheme;
    "1:https" https;
    "1:http" http;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size 100m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
${FORGE_REAL_IP_DIRECTIVES}

    # Docker's embedded DNS: re-resolve the api service so a recreated container is followed.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream api:8000;

    # API and OpenAI-compatible surface (ADR-011). SSE needs buffering off.
    location ~ ^/(api|v1)/ {
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # The client address as nginx resolved it (see realip below), not what the client sent.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    location = /index.html {
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    }

    # The dark theme is loaded by name (not hashed): revalidate it so upgrades take effect.
    location = /theme-dark.css {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Hashed bundles are immutable.
    location ~* \.(?:js|css|woff2?|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Brand images and favicons keep stable names, so they must stay revalidatable.
    location ~* \.(?:svg|png|ico)$ {
        add_header Cache-Control "public, max-age=86400" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "public, max-age=86400" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
